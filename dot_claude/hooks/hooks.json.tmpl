{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [
        {
          "type": "command",
          "command": "{{ .chezmoi.homeDir }}/.claude/hooks/session-sync-global-memory.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "{{ .chezmoi.homeDir }}/.claude/hooks/gh_write_guard.sh"
        }
      ]
    }
  ]
}
